{
  "main": "lib/index.js",
  "scripts": {
    "genkit:watch": "genkit start -o -- tsx --env-file=.env.local --watch",
    "genkit:start": "npm run genkit:watch -- src/genkit-sample.ts",
    "genkit:feedback": "npm run genkit:watch -- src/diary-feedback",
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore --inspect-functions",
    "genkit:emulators": "genkit start -- npm run serve",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "name": "functions",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@firebase/app": "^0.16.0",
    "@genkit-ai/firebase": "^1.40.1",
    "@genkit-ai/google-genai": "^1.40.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "genkit": "^1.40.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
