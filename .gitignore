# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
# Firebase のネイティブ設定は各自 flutterfire configure で生成する（リポジトリでは管理しない）
# 本物の設定を同梱するとダミーの firebase_options.dart と不整合になり
# iOS で [core/duplicate-app] を引き起こすため、トラッキングしない
/ios/Runner/GoogleService-Info.plist
/android/app/google-services.json
/ios/firebase_app_id_file.json
/macos/Runner/GoogleService-Info.plist

# firebase.json は firestore/functions/emulators の設定を含むため管理する。
# ただし flutterfire configure が追記する flutter キーは実プロジェクトの設定を
# 含むため、コミットには含めない（ローカルにのみ保持する）
# .firebaserc は実プロジェクトIDを含むため管理しない
/.firebaserc

**/firebase_options.dart
# firebase init の skills オプションが生成するAIエディタ用ファイル（ローカル利用のみ）
/.agents/
/.claude/
/skills-lock.json
